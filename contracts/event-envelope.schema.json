{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aegis Companion Event Envelope",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "event_id",
    "correlation_id",
    "event_type",
    "mode",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_name": {
      "const": "aegis.companion.event"
    },
    "schema_version": {
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "PAPER",
        "REPLAY",
        "RESEARCH"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}